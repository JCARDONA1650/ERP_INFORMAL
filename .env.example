# Copiar a .env y completar. Nunca subir .env al repositorio.

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:9001

# Puerto expuesto en tu equipo (9000 puede estar ocupado por otro proyecto)
WEB_PORT=9001

# PostgreSQL
POSTGRES_DB=erp_informal
POSTGRES_USER=erp_informal
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432
