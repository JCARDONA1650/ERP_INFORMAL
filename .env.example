# Copiar a .env y completar. Nunca subir .env al repositorio.

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:9001
# Produccion tras un proxy HTTPS (dejar en 0 en desarrollo)
DJANGO_BEHIND_PROXY=0
DJANGO_SSL_REDIRECT=0
# Segundos de HSTS (0 = desactivado). Activar solo cuando el HTTPS ya funcione bien.
DJANGO_HSTS_SECONDS=0
# URL publica del frontend (enlace que lleva el QR de marcacion)
FRONTEND_BASE_URL=http://localhost:4200
# Origenes del frontend Angular permitidos por CORS (separados por coma)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Duracion de los tokens JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Puerto expuesto en tu equipo (9000 puede estar ocupado por otro proyecto)
WEB_PORT=9001

# PostgreSQL
POSTGRES_DB=erp_informal
POSTGRES_USER=erp_informal
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432
