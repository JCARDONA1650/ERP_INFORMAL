# Producción. Copiar a .env en el servidor y completar. Nunca subir .env al repositorio.
# Generar la clave:  python -c "import secrets; print(secrets.token_urlsafe(64))"

# Django
DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=erp.tu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.tu-dominio.com

# Detrás de un proxy HTTPS
DJANGO_BEHIND_PROXY=1
DJANGO_SSL_REDIRECT=1
# Dejar en 0 hasta comprobar que el HTTPS funciona; luego p. ej. 31536000 (1 año).
DJANGO_HSTS_SECONDS=0

# URL pública (enlace que lleva el QR de marcación)
FRONTEND_BASE_URL=https://erp.tu-dominio.com

# Puerto local en el que nginx escucha (el proxy HTTPS apunta aquí)
HTTP_PORT=8080

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# PostgreSQL (POSTGRES_HOST debe ser el nombre del servicio: db)
POSTGRES_DB=erp_informal
POSTGRES_USER=erp_informal
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_FUERTE
POSTGRES_HOST=db
POSTGRES_PORT=5432
